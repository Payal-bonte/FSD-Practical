# Display employee details stored in a Python list.

from flask import Flask

app = Flask(__name__)

@app.route('/')
def employee_list():

    employees = [
        ("Shreya Fulawade", "IT", 45000),
        ("Tanvi Jadhv", "HR", 40000),
        ("Apeksha Mutake", "Finance", 50000),
        ("Neha Shinde", "Marketing", 42000),
        ("Payal Bonte", "IT", 55000)
    ]

    result = "<h2>Employee Details</h2>"

    for name, department, salary in employees:
        result += f"""
            Name  : {name}<br>
            Department : {department}<br>
            Salary : ₹{salary}<br><br>
        """
    return result

if __name__ == "__main__":
    app.run(debug=True)